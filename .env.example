# Copy to .env and set values (Vite expects VITE_ prefix for client env vars)
VITE_NVD_BASE_URL=https://nvd.nist.gov/vuln/detail
VITE_CISA_BASE_URL=https://www.cve.org/CVERecord?id
VITE_CANONICAL_PRIORITY=NVD,CISA,VENDOR
# Optionally set an API key for providers
# VITE_NVD_API_KEY=

# Backend API base URL (for CVE data)
VITE_API_BASE_URL=http://localhost:8000
# Auth service base URL
VITE_AUTH_BASE_URL=http://localhost:8001
