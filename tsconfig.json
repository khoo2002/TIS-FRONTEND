{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
  "jsx": "react-jsx",
  "types": ["vite/client", "vitest/globals"],
    "strict": true
  },
  "include": ["src"]
}
